{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-air.local/truth/registry.schema.json",
  "title": "open-air truth registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "cases"],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "manifest", "status", "truth_sha256"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "manifest": {
            "type": "string"
          },
          "status": {
            "enum": ["active", "deferred", "blocked-data-access"]
          },
          "truth_sha256": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "holdout_sha256": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        }
      }
    }
  }
}
